# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# Required for CrewAI agents (OpenAI)
OPENAI_API_KEY=sk-...

# Required for news search tools (Serper)
SERPER_API_KEY=...

# Optional: higher OpenFIGI rate limits
# OPENFIGI_API_KEY=...

# Report language (overrides config/settings.yaml when set)
# Examples: English, Italian
REPORT_LANGUAGE=English
