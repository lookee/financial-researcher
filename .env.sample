# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# Required for CrewAI agents (OpenAI)
OPENAI_API_KEY=sk-...

# Required for news search tools (Serper)
SERPER_API_KEY=...

# Optional: higher OpenFIGI rate limits
# OPENFIGI_API_KEY=...

# Optional: Finnhub company news (prefetch layer; free tier ~60 calls/min)
# FINNHUB_API_KEY=...
# FINNHUB_ENABLED=true
# FINNHUB_NEWS_LOOKBACK_DAYS=14

# Briefing language (overrides defaults/settings.yaml when set)
# Examples: English, Italian
REPORT_LANGUAGE=English

# Model lineup profile: … | openrouter_auto_top | openrouter_auto_medium | openrouter_auto_max_savings | openrouter_auto
# (overrides settings.yaml; same as --model-profile)
# FR_MODEL_PROFILE=balanced

# DeepSeek — required for FR_MODEL_PROFILE=deepseek (replaces OPENAI_API_KEY)
# DEEPSEEK_API_KEY=sk-...

# Anthropic — required for FR_MODEL_PROFILE=anthropic or multi (with other keys)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — required for FR_MODEL_PROFILE=free_openrouter_nex or openrouter_auto
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_AUTO_TRADEOFF=7

# Optional: per-agent model overrides (beat the active profile)
# FR_MODEL_MARKET=openai/gpt-5.4-mini
# FR_MODEL_NEWS=openai/gpt-5.5
# FR_MODEL_OUTLOOK=openai/gpt-5.4
# FR_MODEL_CALENDAR=openai/gpt-5.4-mini
# FR_MODEL_CHIEF=openai/gpt-5.5

# Groq API key — required only for FR_MODEL_PROFILE=free_groq
# GROQ_API_KEY=gsk_...

# Optional: override watchlist location (default: ./config/watchlist.yaml)
# WATCHLIST_PATH=config/watchlist.yaml

# Email delivery via Resend (https://resend.com)
# RESEND_API_KEY=re_...
# BRIEFING_EMAIL_FROM=Financial Researcher <onboarding@resend.dev>
# BRIEFING_EMAIL_TO=you@example.com
# BRIEFING_EMAIL_TO=you@example.com,colleague@example.com
# BRIEFING_EMAIL_SUBJECT_PREFIX=[Watchlist]
# BRIEFING_EMAIL_AUTO=1

# Run metadata footer in the briefing (enabled by default; set 0 to hide)
# BRIEFING_RUN_METADATA=0

# Optional: global user config directory (default: ~/.config/financial_researcher)
# FINANCIAL_RESEARCHER_CONFIG_DIR=~/.config/financial_researcher
