# Example watchlist — copied to ./config/watchlist.yaml on first run if missing.
# Committed template for this repo: config/watchlist.yaml.example (same content).
#
# AI & hypertech theme on Borsa Italiana (Milan): two thematic ETFs plus two
# semiconductor / AI bellwether stocks. NVIDIA trades on the Borsa Italiana
# Global Equity Market (GEM) via the 1NVDA.MI line.

# Optional: override default_language from defaults/settings.yaml for this batch only.
# language: English

instruments:
  # --- ETFs (Borsa Italiana) ---
  - isin: IE00BMC38736
    ticker: SMH.MI
    type: etf

  - isin: IE00BDVPNG13
    ticker: WTAI.MI
    type: etf

  # --- Equities (Borsa Italiana) ---
  - isin: US67066G1040
    ticker: 1NVDA.MI
    type: stock

  - isin: NL0000226223
    ticker: STMMI.MI
    type: stock
